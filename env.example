# Anthropic API key for the agent brain
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather (https://t.me/BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# Telegram chat id to post proactive briefings/reminders to.
# Leave empty until you've run the bot once, sent a message from the family
# group (with the bot added to it), and copied the chat id the bot logs to
# the console.
TELEGRAM_CHAT_ID=

# IANA timezone used for scheduling and "today"/"tomorrow" resolution
TRIP_TZ=Europe/Vienna

# Hour (0-23, local TRIP_TZ) to send the evening briefing for tomorrow
BRIEFING_HOUR=20

# Hour (0-23) for an optional lightweight morning weather nudge, comment out to disable
MORNING_HOUR=8

# Path to the trip knowledge base JSON (relative to project root)
TRIP_DATA_PATH=data/trip.json

# Path to the kosher supervision list JSON (relative to project root)
KOSHER_DATA_PATH=data/kosher.json

# Claude model for the agent
CLAUDE_MODEL=claude-sonnet-4-5
